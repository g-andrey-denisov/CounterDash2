# Скопируй этот файл в .env и заполни реальными значениями.
# Файл .env в git не попадает (см. .gitignore).

FLASK_SECRET_KEY=change-me-in-production
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
LOG_MAX_DAYS=30         # Сколько дней хранить лог-файлы

DAILY_REPORT_LIMIT=62   # Макс. дней в посуточном отчёте

# MariaDB (БД Ресурс)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DB=resource
MARIADB_USER=
MARIADB_PASSWORD=

# MS SQL Server (RMon4Dev — МОЭСК)
MSSQL_DRIVER=SQL Server   # Windows: "SQL Server" / Linux: "FreeTDS"
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DB=RMon4Dev
MSSQL_USER=
MSSQL_PASSWORD=

# Google Sheets — путь к JSON-ключу сервисного аккаунта
GOOGLE_SA_KEY_PATH=credentials/google_sa.json

# Google Sheets — Spreadsheet IDs и имена листов
GOOGLE_SHEETS_RESOURCE_ID=
GOOGLE_SHEETS_RESOURCE_SHEET=Ресурс
GOOGLE_SHEETS_MOESK_ID=
GOOGLE_SHEETS_MOESK_SHEET=moesk

# Бэкапы Google Sheets
SHEETS_BACKUP_DIR=backups/sheets
SHEETS_BACKUP_MAX_DAYS=32
